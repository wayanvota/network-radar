# Required for OpenAI enrichment and semantic search.
OPENAI_API_KEY=

# Optional. Required for direct Google Contacts and Gmail sync.
# Create an OAuth desktop/web client in Google Cloud and add this redirect URI:
# http://127.0.0.1:5178/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5178/auth/google/callback

# Optional defaults.
PORT=5178
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ENRICH_MODEL=gpt-4.1-mini
LINKEDIN_HEADLESS=false
