{
  "name": "network-radar",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Local-first personal network search with Google, Gmail, LinkedIn, and OpenAI enrichment.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --check server.mjs && node --check app.js",
    "init-db": "node server.mjs --init-db",
    "import:linkedin": "node scripts/import-linkedin.mjs",
    "test:e2e": "playwright test",
    "test:ci": "npm run check && npm run test:e2e"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
